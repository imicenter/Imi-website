// ORDERS ke rules - Firebase Console > Firestore Database > Rules me apne maujooda rules ke andar
// (rules_version / service cloud.firestore / match /databases/{database}/documents { ... } ke andar)
// sirf yeh `match /orders/{orderId}` block jodein. Baaki rules (services, siteStats) jaise hain waise rakhein.

match /orders/{orderId} {
  // Koi bhi visitor order bhej sakta hai, par sirf sahi format me
  allow create: if request.resource.data.keys().hasOnly([
      'orderNo','serviceId','serviceName','serviceHi','price','coupon','total',
      'name','mobile','address','note','status','paymentStatus','paymentMethod',
      'page','lang','createdAt'])
    && request.resource.data.name is string
    && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 80
    && request.resource.data.mobile is string
    && request.resource.data.mobile.matches('^[6-9][0-9]{9}$')
    && request.resource.data.serviceName is string
    && request.resource.data.serviceName.size() >= 1 && request.resource.data.serviceName.size() <= 200
    && request.resource.data.address is string && request.resource.data.address.size() <= 300
    && request.resource.data.note is string && request.resource.data.note.size() <= 500
    && request.resource.data.total is number
    && request.resource.data.total >= 0 && request.resource.data.total < 1000000
    && request.resource.data.status == 'New'
    && request.resource.data.paymentStatus == 'Pending';

  // Padhna, status badalna, delete karna - sirf login kiya hua admin
  allow read, update, delete: if request.auth != null;
}
